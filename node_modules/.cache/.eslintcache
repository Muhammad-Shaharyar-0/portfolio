jects from './components/Projects/Projects'\r\nimport Skills from './components/Skills/Skills'\r\nimport ScrollToTop from './components/ScrollToTop/ScrollToTop'\r\nimport Contact from './components/Contact/Contact'\r\nimport Footer from './components/Footer/Footer'\r\nimport './App.css'\r\nimport bgSection from './Images/persona.png'  // your image\r\n\r\nconst App = () => {\r\n  const [{ themeName }] = useContext(ThemeContext)\r\n\r\n  return (\r\n    <div id='top' className={`${themeName} app`}>\r\n      <Header />\r\n\r\n      <main>\r\n        <About />\r\n        <Projects />\r\n        <Skills />\r\n        \r\n        <Contact />\r\n      </main>\r\n\r\n      <ScrollToTop />\r\n      \r\n      <Footer />\r\n    </div>\r\n  )\r\n}\r\n\r\nexport default App\r\n","I:\\portfolio\\src\\contexts\\theme.js",[],"I:\\portfolio\\src\\components\\Projects\\Projects.js",[],"I:\\portfolio\\src\\components\\Header\\Header.js",["64"],"import { header } from '../../portfolio'\r\nimport Navbar from '../Navbar/Navbar'\r\nimport footerImg from '../../Images/persona3.png'\r\nimport './Header.css'\r\n\r\nconst Header = () => {\r\n  const { homepage, title } = header\r\n\r\n  return (\r\n    <div className='header__wrapper'>\r\n      <header className='header center'>\r\n        <h3>\r\n\r\n          {homepage ? (\r\n            <a href={homepage} className='link'>\r\n              {title} ☠️\r\n            </a>\r\n          ) : (\r\n            title\r\n          )}\r\n        </h3>\r\n        <Navbar />\r\n      </header>\r\n    </div>\r\n  )\r\n}\r\n\r\nexport default Header","I:\\portfolio\\src\\components\\Footer\\Footer.js",[],"I:\\portfolio\\src\\components\\ScrollToTop\\ScrollToTop.js",[],"I:\\portfolio\\src\\components\\About\\About.js",["65"],"import GitHubIcon from '@material-ui/icons/GitHub'\r\nimport LinkedInIcon from '@material-ui/icons/LinkedIn'\r\nimport { about } from '../../portfolio'\r\nimport './About.css'\r\nimport aboutBg from '../../Images/persona1.png'\r\nimport keyblade from '../../Images/keyblade.png'\r\n\r\n\r\n// const About = () => {\r\n//   const { name, role, description, resume, social, picture } = about\r\n\r\n//   let imageSrc = ''\r\n//   if (picture) {\r\n//     if (picture.startsWith('http')) {\r\n//       imageSrc = picture\r\n//     } else if (picture.startsWith('/')) {\r\n//       imageSrc = `${process.env.PUBLIC_URL}${picture}`\r\n//     } else {\r\n//       imageSrc = `${process.env.PUBLIC_URL}/images/${picture}`\r\n//     }\r\n//   }\r\n\r\n//   return (\r\n//     <div className='about center'>\r\n//       <div className='about__header'>\r\n//         {picture && (\r\n//           <img src={imageSrc} alt={name} className='about__picture' />\r\n//         )}\r\n\r\n//         <div className='about__intro'>\r\n//           {name && (\r\n//             <h1>\r\n//               <span className='about__name'>{name}.</span>\r\n//             </h1>\r\n//           )}\r\n\r\n//           {role && <h2 className='about__role'>{role}.</h2>}\r\n//           <p className='about__desc'>{description}</p>\r\n//         </div>\r\n//       </div>\r\n\r\n//       <div className='about__contact center'>\r\n//         {resume && (\r\n//           <a href={resume}>\r\n//             <span type='button' className='btn btn--outline'>\r\n//               Resume\r\n//             </span>\r\n//           </a>\r\n//         )}\r\n\r\n//         {social && (\r\n//           <>\r\n//             {social.github && (\r\n//               <a\r\n//                 href={social.github}\r\n//                 aria-label='github'\r\n//                 className='link link--icon'\r\n//               >\r\n//                 <GitHubIcon />\r\n//               </a>\r\n//             )}\r\n\r\n//             {social.linkedin && (\r\n//               <a\r\n//                 href={social.linkedin}\r\n//                 aria-label='linkedin'\r\n//                 className='link link--icon'\r\n//               >\r\n//                 <LinkedInIcon />\r\n//               </a>\r\n//             )}\r\n//           </>\r\n//         )}\r\n//       </div>\r\n//     </div>\r\n//   )\r\n// }\r\n\r\n// export default About\r\n\r\nconst About = () => {\r\n  const { name, role, description, resume, showResume, social, picture } = about\r\n\r\n  // compute image src safely\r\n  let imageSrc = ''\r\n  if (picture) {\r\n    if (picture.startsWith('http')) {\r\n      imageSrc = picture\r\n    } else if (picture.startsWith('/')) {\r\n      imageSrc = `${process.env.PUBLIC_URL}${picture}`\r\n    } else {\r\n      imageSrc = `${process.env.PUBLIC_URL}/images/${picture}`\r\n    }\r\n  }\r\n   \r\n  return (\r\n    <div className='about center'>\r\n      <div className='about__header'>\r\n        {/* <img src={aboutBg} alt='' className='about__image' /> */}\r\n        {picture && (\r\n          <img src={imageSrc} alt={name} className='about__picture' />\r\n        )}\r\n\r\n        <div className='about__intro'>\r\n          {name && (\r\n            <h1>\r\n              <span className='about__name'>{name}.</span>\r\n            </h1>\r\n          )}\r\n\r\n          {role && <h2 className='about__role'>{role}.</h2>}\r\n          <p className='about__desc'>{description}</p>\r\n        </div>\r\n      </div>\r\n\r\n      <div className='about__contact'>\r\n  {/* LEFT button */}\r\n  {showResume && resume && (\r\n    <a\r\n      href={resume}\r\n      target='_blank'\r\n      rel='noopener noreferrer'\r\n      className='btn btn--outline'\r\n    >\r\n      <img src={keyblade} alt='' className='about__keyblade' />\r\n      Resume\r\n    </a>\r\n  )}\r\n\r\n  {/* MIDDLE icons */}\r\n  <div className='about__social-icons'>\r\n    {social && (\r\n      <>\r\n        {social.github && (\r\n          <a\r\n            href={social.github}\r\n            aria-label='github'\r\n            className='link link--icon'\r\n            target='_blank'\r\n            rel='noopener noreferrer'\r\n          >\r\n            <GitHubIcon />\r\n          </a>\r\n        )}\r\n        {social.linkedin && (\r\n          <a\r\n            href={social.linkedin}\r\n            aria-label='linkedin'\r\n            className='link link--icon'\r\n            target='_blank'\r\n            rel='noopener noreferrer'\r\n          >\r\n            <LinkedInIcon />\r\n          </a>\r\n        )}\r\n      </>\r\n    )}\r\n  </div>\r\n\r\n  {/* RIGHT button */}\r\n  {social.favouriteGames && (\r\n    <a\r\n      href={social.favouriteGames}\r\n      target='_blank'\r\n      rel='noopener noreferrer'\r\n      className='btn btn--outline'\r\n    >\r\n      🎮 My Favourite Games\r\n    </a>\r\n  )}\r\n</div>\r\n    </div>\r\n  )\r\n}\r\n\r\nexport default About\r\n","I:\\portfolio\\src\\components\\Skills\\Skills.js",[],"I:\\portfolio\\src\\components\\Contact\\Contact.js",[],"I:\\portfolio\\src\\portfolio.js",[],"I:\\portfolio\\src\\components\\ProjectContainer\\ProjectContainer.js",[],"I:\\portfolio\\src\\components\\Navbar\\Navbar.js",[],{"ruleId":"66","replacedBy":"67"},{"ruleId":"68","replacedBy":"69"},{"ruleId":"70","replacedBy":"71"},{"ruleId":"72","replacedBy":"73"},{"ruleId":"74","replacedBy":"75"},{"ruleId":"76","severity":1,"message":"77","line":11,"column":8,"nodeType":"78","messageId":"79","endLine":11,"endColumn":17},{"ruleId":"76","severity":1,"message":"80","line":3,"column":8,"nodeType":"78","messageId":"79","endLine":3,"endColumn":17},{"ruleId":"76","severity":1,"message":"81","line":5,"column":8,"nodeType":"78","messageId":"79","endLine":5,"endColumn":15},"lines-around-directive",["82"],"global-require",[],"no-buffer-constructor",[],"no-new-require",[],"no-path-concat",[],"no-unused-vars","'bgSection' is defined but never used.","Identifier","unusedVar","'footerImg' is defined but never used.","'aboutBg' is defined but never used.","padding-line-between-statements"]